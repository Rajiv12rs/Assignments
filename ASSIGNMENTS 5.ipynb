   "source": [
    "import re\n",
    "\n",
    "string = input(\"Enter a string: \")\n",
    "\n",
    "if re.fullmatch(\"[a-zA-Z0-9]+\", string):\n",
    "    print(\"String contains only letters and numbers.\")\n",
    "else:\n",
    "    print(\"String contains special characters.\")"
   ]
